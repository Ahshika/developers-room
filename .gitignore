node_modules/
dist/
test-results/
playwright-report/
*.log
.vite/
# third-party reference material must never be committed
reference/
# personal Claude Code settings stay on this machine
.claude/
# Blender working files and renders are large and regenerable (tools/blender/*.py)
blender/work/
blender/renders/
