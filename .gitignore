blender/incoming/
blender/*.fbx
# downloaded third-party sources (re-fetch with tools/fetch_polyhaven.py; manifest kept)
blender/sources/*
!blender/sources/polyhaven/
blender/sources/polyhaven/*
!blender/sources/polyhaven/manifest.json
__pycache__/
*.pyc
